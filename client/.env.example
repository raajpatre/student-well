# StudentWell client environment.
# Copy to client/.env and fill in. Variables prefixed with VITE_ are bundled
# into the production JS — they are PUBLIC by definition. Never put secrets here.

# Supabase project URL (same one the server uses).
VITE_SUPABASE_URL=

# Supabase ANON key. This is the public client key — safe to ship to the browser.
# Do NOT use the service-role key here; it bypasses RLS and is a server-only secret.
VITE_SUPABASE_ANON_KEY=

# Server origin, e.g. http://localhost:3001 in dev or https://api.studentwell.com in prod.
VITE_API_BASE_URL=http://localhost:3001
