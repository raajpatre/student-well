# StudentWell server environment.
# Copy to server/.env and fill in. Never commit the real .env file.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development          # 'development' or 'production'.
                              # When 'production' the error handler strips
                              # stack traces from responses.
PORT=3001                     # Optional. Defaults to 3001.

# ── Frontend origin ────────────────────────────────────────────────────────
# Where the client is served from. Used in the CORS allowlist.
# Localhost on any port is always allowed in dev.
CLIENT_URL=http://localhost:5173

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL + service-role key. The service-role key bypasses RLS, so it
# MUST stay server-side. Never ship it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────
# Used for server-side JWT verification alongside Supabase Auth.
# Should match the Supabase project's JWT secret if you're verifying
# Supabase-issued tokens directly.
JWT_SECRET=

# ── Newton token encryption ────────────────────────────────────────────────
# 64 hex characters = 32 bytes. Generate with:
#   openssl rand -hex 32
# Rotating this key invalidates every stored Newton token; students will
# have to reconnect their accounts.
ENCRYPTION_KEY=

# ── AI providers ───────────────────────────────────────────────────────────
# Google AI Studio key. Used by the chat counsellor.
GEMINI_API_KEY=

# ── WhatsApp notifications (optional) ─────────────────────────────────────
# Leave blank to fall back to in-app notifications only. If set, the
# notification service routes manager/escalation alerts through WhatsApp.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
